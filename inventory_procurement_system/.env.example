# FreeLLMAPI Configuration (local router from Microsoft Store)
# Get your unified API key from the FreeLLMAPI desktop app dashboard
# Copy this file to .env and fill in your values
FREE_LLM_API_URL=http://localhost:3001/v1
FREE_LLM_API_KEY=your-freellmapi-unified-key-here
FREE_LLM_MODEL=auto

# Google GenAI fallback (used if FreeLLMAPI is not configured)
GOOGLE_API_KEY=your-google-api-key-here

# App configuration
SECRET_KEY=dev-fallback-key-change-in-production
DATABASE_URL=sqlite:///database.db
ADMIN_EMAIL=
PROCUREMENT_PIPELINE_URL=http://localhost:3000
PROCUREMENT_PIPELINE_TOKEN=